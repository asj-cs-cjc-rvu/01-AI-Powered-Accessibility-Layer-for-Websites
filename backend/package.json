{
  "name": "@studylens/backend",
  "version": "2.0.0",
  "private": true,
  "description": "StudyLens backend API (Node.js + Express)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "rm -rf dist-tests && tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('dist-tests/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "node --test dist-tests/tests/*.test.js"
  },
  "dependencies": {
    "@studylens/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}