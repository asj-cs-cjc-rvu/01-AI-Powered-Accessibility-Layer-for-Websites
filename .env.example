# StudyLens environment template.
# Copy to the repository ROOT as .env:   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---------- Backend server ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# ---------- AI Provider (backend only - NEVER put these in the extension) ----------
# groq = real Groq Cloud calls (billable). mock = offline deterministic provider (free).
# .env — never committed
AI_PROVIDER=mock
GROQ_API_KEY=

# Preview model: Groq lists qwen/qwen3.8-27b at $0.80/1M input, $4.00/1M output.
# Preview models may be discontinued at short notice. Change this value to switch models.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------- AI Request Configuration ----------
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# ---------- Limits ----------
# Informational only. Enforced value lives in shared/src/contracts/api.ts (5000 chars).
MAX_TEXT_LENGTH=5000

# ---------- Persistence ----------
ENABLE_REQUEST_HISTORY=false