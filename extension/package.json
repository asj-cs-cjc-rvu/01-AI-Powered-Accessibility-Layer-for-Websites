{
  "name": "@studylens/extension",
  "version": "1.0.0",
  "private": true,
  "description": "StudyLens Chrome Extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:app": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "tsc --noEmit && npm run build:app && npm run build:content",
    "pretest": "rm -rf dist-tests && tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('dist-tests/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "node --test dist-tests/content/capture.test.js dist-tests/types/messages.test.js dist-tests/services/backend.test.js dist-tests/sidepanel/App.test.js"
  },
  "dependencies": {
    "@studylens/shared": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.0"
  }
}